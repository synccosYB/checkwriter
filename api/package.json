{
  "name": "synccos-backend-check-writer",
  "version": "1.0.0",
  "description": "Synccos Check Writer Backend Microservice",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "cross-env NODE_ENV=dev tsx watch src/index.ts",
    "prestart": "npm run db:migrate",
    "build": "cross-env NODE_ENV=prod tsc && cp -r config dist/config",
    "dev": "cross-env NODE_ENV=dev tsx watch src/index.ts",
    "test": "cross-env NODE_ENV=dev sh -c 'tsx --test $(find src -name \"*.test.mjs\")'",
    "prod": "cross-env NODE_ENV=production tsx watch src/index.ts",
    "preprod": "npm run db:migrate",
    "postinstall": "node -e \"if (!process.env.PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD) { require('child_process').execSync('npx playwright install chromium', {stdio: 'inherit'}); }\" || true",
    "export:spaces": "node scripts/export-spaces.mjs",
    "export:data": "node scripts/export-all.mjs",
    "export:postgres": "node scripts/export-postgres.mjs",
    "import:postgres": "node scripts/import-postgres.mjs",
    "db:apply-indexes": "node scripts/apply-indexes.mjs",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crudcook/synccos-backend-check-writer.git"
  },
  "author": "Kunal Kumar",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Crudcook/synccos-backend-check-writer/issues"
  },
  "homepage": "https://github.com/Crudcook/synccos-backend-check-writer#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1020.0",
    "@aws-sdk/s3-request-presigner": "^3.1020.0",
    "@json2csv/plainjs": "^7.0.6",
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@sendgrid/mail": "^8.1.6",
    "axios": "^1.15.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.2",
    "config": "^3.3.12",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cron": "^2.4.0",
    "crypto": "^1.0.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "handlebars": "^4.7.9",
    "intuit-oauth": "^4.2.0",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.18.0",
    "mailchimp": "^1.2.1",
    "moment": "^2.29.4",
    "multer": "^2.0.1",
    "node-cache": "^5.1.2",
    "node-quickbooks": "^2.0.46",
    "nodemon": "^2.0.22",
    "number-to-words": "^1.2.4",
    "papaparse": "^5.5.3",
    "pg": "^8.20.0",
    "playwright": "^1.51.0",
    "qrcode": "^1.5.4",
    "shippo": "^1.7.1",
    "speakeasy": "^2.0.0",
    "stripe": "^12.16.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.3",
    "tsx": "^4.19.3",
    "twilio": "^5.4.3",
    "uuid": "^9.0.0"
  },
  "overrides": {
    "fast-xml-parser": "^4.5.5",
    "lodash": "^4.18.0",
    "lodash-es": "^4.18.0",
    "form-data": "^4.0.4",
    "minimatch": "^9.0.7",
    "path-to-regexp": "^0.1.13",
    "picomatch": "^2.3.2",
    "semver": "^7.5.2",
    "underscore": "^1.13.8",
    "flatted": "^3.4.2",
    "glob": "^10.5.0",
    "jsonpath": "^1.3.0",
    "node-forge": "^1.4.0",
    "rollup": "^2.80.0",
    "serialize-javascript": "^7.0.3",
    "svgo": "^2.8.1"
  },
  "devDependencies": {
    "@types/config": "^3.3.5",
    "@types/express": "^5.0.1",
    "@types/lodash": "^4.17.20",
    "@types/mailchimp__mailchimp_marketing": "^3.0.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.16.5",
    "@types/papaparse": "^5.3.16",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.8.3"
  }
}
